{
  "name": "pleos-27-axis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run verify:pathtracer",
    "verify:pathtracer": "node scripts/verify-pathtracer.mjs",
    "verify:raw": "node scripts/verify-raw-webgl2.mjs",
    "verify:axis": "node scripts/verify-axis-core.mjs",
    "verify:solid": "node scripts/verify-solid-axis.mjs",
    "verify:exports": "node scripts/verify-export-artifacts.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:spectral": "node scripts/verify-spectral-artifacts.mjs",
    "compare:legacy": "node scripts/compare-legacy-rebuild.mjs",
    "qa": "npm run lint && npm run verify:pathtracer && npm run build"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.180.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.14",
    "xatlas-web": "^0.1.0"
  }
}
