{
  "version": 1,
  "scope": "PLEOS Raw WebGL2 Rendering Studio — Phase 1",
  "policy": {
    "purpose": "Declare required QA evidence without treating planned or copied files as newly rendered output.",
    "allowedProvenance": [
      "direct browser screenshot of the named renderer state",
      "PNG produced by the raw renderer offscreen export path",
      "byte-for-byte copy of an earlier local legacy capture, explicitly labeled as legacy"
    ],
    "prohibitedProvenance": [
      "reference artwork presented as renderer output",
      "AI-generated substitute",
      "manually composited or retouched result",
      "renamed file whose renderer, preset, dimensions, or capture time is unknown"
    ],
    "referenceAssetRule": "The supplied PDFs and JPG may be inspected locally, but must never enter the production texture, shader, compositing, or Vite public-asset graph.",
    "verification": "File presence is reported by npm run verify:raw. Set RAW_WEBGL2_REQUIRE_ARTIFACTS=1 only after every capture has real provenance metadata.",
    "browserCaptureConstraint": "If browser automation is blocked, leave the artifact absent and record the limitation; do not fabricate a result."
  },
